# Puerto del health check (Render necesita un puerto HTTP en un Web Service)
PORT=4100

# RabbitMQ. Local: docker compose. Producción: AMQP URL de CloudAMQP (amqps://...)
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Supabase (mismo proyecto que el back): tickets y mensajes_dlq
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx
