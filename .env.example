# Puerto del health check (Render necesita un puerto HTTP en un Web Service)
PORT=4100

# RabbitMQ. Local: docker compose. Producción: AMQP URL de CloudAMQP (amqps://...)
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Supabase (mismo proyecto que el back): tickets y mensajes_dlq
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------- Kafka (EP5)
# Kafka complementa a RabbitMQ para el stream analitico; no lo reemplaza.
#
# KAFKA_ENABLED=false deja el worker funcionando exactamente como antes (solo
# consume de RabbitMQ). Se usa en Render: el cluster Kafka esta protegido por
# Security Group y Render no tiene IP de salida fija.
KAFKA_ENABLED=true

# Brokers del cluster (docker/kafka-cluster).
# Local: localhost:9092,localhost:9094,localhost:9096
# EC2:   <IP-publica>:9092,<IP-publica>:9094,<IP-publica>:9096
KAFKA_BROKERS=localhost:9092,localhost:9094,localhost:9096
KAFKA_CLIENT_ID=pedidos360-worker

# Topicos y consumer groups (valores por defecto si se omiten)
KAFKA_EVENTOS_TOPIC=pedidos.eventos.v1
KAFKA_METRICAS_TOPIC=pedidos.metricas.v1
KAFKA_DLT_TOPIC=pedidos.eventos.dlt.v1
KAFKA_ANALITICA_GROUP_ID=pedidos360-analitica
KAFKA_PROYECCION_GROUP_ID=pedidos360-proyeccion
KAFKA_DLT_GROUP_ID=pedidos360-dlt-monitor
