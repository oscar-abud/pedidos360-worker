# Copiar a .env (en la EC2) y cambiar por valores propios. NO subir el .env.

# IP pública (o dominio) de la EC2 donde corre este clúster. Es la dirección
# que los brokers ANUNCIAN a los clientes: si queda en localhost, el back y el
# worker se conectarán bien la primera vez y luego fallarán al pedir metadata.
KAFKA_EXTERNAL_HOST=1.2.3.4

# Credenciales de Kafka-UI (http://<IP>:8080). Desde ahí se pueden borrar
# tópicos, así que conviene una clave larga.
KAFKA_UI_USER=pedidos360
KAFKA_UI_PASSWORD=cambia-esta-clave-larga-y-aleatoria
