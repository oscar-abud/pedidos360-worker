# Copiar a .env (en la EC2) y cambiar por valores propios. NO subir el .env.
# Contraseña larga: RabbitMQ queda expuesto a internet (puertos 5672/5673/15672).
RABBITMQ_USER=pedidos360
RABBITMQ_PASSWORD=cambia-esta-clave-larga-y-aleatoria

# Cookie compartido por los 2 nodos (cualquier texto largo y secreto).
RABBITMQ_ERLANG_COOKIE=cambia-este-cookie-largo-y-secreto
